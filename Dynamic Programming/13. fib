#include <stdio.h>

// ডাইনামিক প্রোগ্রামিং ব্যবহার করে ফিবোনাচ্চি বের করার ফাংশন
unsigned long long fibonacci(int n) {
    // বেস কেস চেক
    if (n <= 0) return 0;
    if (n == 1) return 1;

    // ১-ডাইমেনশনাল ডিপি টেবিল বা অ্যারে তৈরি করা
    unsigned long long dp[n + 1];

    // বেস কেসগুলোর মান টেবিলে বসানো
    dp[0] = 0;
    dp[1] = 1;

    // লুপের সাহায্যে আগের দুটি ঘরের মান যোগ করে টেবিল পূরণ করা
    for (int i = 2; i <= n; i++) {
        dp[i] = dp[i - 1] + dp[i - 2]; // সূত্র: F(n) = F(n-1) + F(n-2)
    }

    // কাঙ্ক্ষিত n-তম ফিবোনাচ্চি সংখ্যাটি রিটার্ন করা
    return dp[n];
}

int main() {
    int n = 10; // আমরা ১০ নম্বর ফিবোনাচ্চি সংখ্যাটি বের করব
    
    printf("%d-th Fibonacci number is: %llu\n", n, fibonacci(n)); // আউটপুট: 55

    return 0;
}
